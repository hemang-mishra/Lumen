# Where the Python service is. Read when the app is built, not when it runs,
# so each environment gets its own build.
VITE_LUMEN_API_URL=http://localhost:8000

# Whether this deployment expects people to sign in. Off until the sign-in
# screen exists; the service's own LUMEN_AUTH_ENABLED must agree with it.
VITE_AUTH_ENABLED=false
