# Lumen configuration template.
#
#   cp .env.example .env
#
# Copy this file to .env and edit it. .env is gitignored; this file is not, so
# never put a real credential here.
#
# Every setting below is optional — leaving a line commented out uses the
# default shown next to it, which is the same default written in
# lumen/config.py. The handful of lines that are *uncommented* are the ones
# where the code default is wrong for running Lumen on a real machine, and
# those are called out where they appear.


# =============================================================================
# Credentials
# =============================================================================
# Read fresh from the environment on every use and never written to any
# database, log line, or config snapshot. Required for anything that calls a
# model: ingestion, extraction, and reading conversational turns. Everything
# else — the graph reads, the debug views — works without it.
GEMINI_API_KEY=
# GOOGLE_API_KEY is accepted as an alternative name for the same credential.

# --- Several keys ------------------------------------------------------------
# Quotas are counted per key, per minute. One key is one meter, and a single
# evening's journalling — a few dozen extraction calls and a few hundred
# embeddings — walks straight into it. Configure more keys and Lumen spreads
# requests across them, which multiplies the ceiling without changing anything
# else about how it runs.
#
# Two ways of listing them; both are read, and the results combined, so either
# is fine and the singular GEMINI_API_KEY above still counts as one of them.
# Duplicates are dropped — the same key under two names is still one meter.
#
# One line:
# GEMINI_API_KEYS=key-one,key-two,key-three
#
# Or one per line, numbered from 1. Reading stops at the first missing number,
# so commenting out _2 hides _3 as well rather than silently skipping it.
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

# How a request picks between them.
#
#   random      (default) picks one at a time, keeping no state. Correct across
#               threads, processes and workers that never see each other, and
#               even enough over any real run.
#   round_robin walks them in order. Strictly even, but only within one
#               process, so it is the better choice only when the total number
#               of requests is small enough for random choice to clump.
#
# Either way, a call that fails is retried under a *different* key — which is
# the point of configuring more than one.
# LUMEN_KEY_ROTATION_STRATEGY=random


# =============================================================================
# Where data lives
# =============================================================================

# Where everybody's knowledge graphs live (Kuzu, an embedded database — no
# server to run). One database per person, named after them, inside this
# directory. Only ONE process may hold a given person's database open at a
# time, so do not point two running copies of Lumen at the same root.
# LUMEN_GRAPH_DB_ROOT=./data/graphs

# How many people's graphs may be open at once. The least recently used one
# is closed to make room; a graph somebody is mid-request on is never the one
# closed. Reopening costs milliseconds.
# LUMEN_MAX_OPEN_GRAPHS=32

# The vector index (Qdrant in local-file mode — again, no server to run).
#
# NOT COMMENTED OUT ON PURPOSE. The code default is ":memory:", which is right
# for tests and quietly wrong for everything else: the graph would keep its
# records across a restart while their embeddings vanished, leaving nodes that
# semantic search can never find again, with nothing reporting an error.
LUMEN_VECTOR_LOCATION=./lumen_vectors
# LUMEN_VECTOR_COLLECTION=lumen_nodes

# Width of the vectors the collection stores. Must match what the configured
# embedding model produces — text-embedding-004 produces 768.
# LUMEN_VECTOR_SIZE=768

# The operational database: session buffers, pipeline job history, the review
# queue, settings. Any SQLAlchemy URL; swapping SQLite for PostgreSQL is a
# change to this line and nothing else.
# LUMEN_OPS_DB_URL=sqlite:///./lumen_ops.db
# LUMEN_OPS_DB_ECHO=false

# The single local user every record is filed under.
# LUMEN_USER_ID=local


# =============================================================================
# Models
# =============================================================================
# Each role resolves independently to a (provider, model) pair. Set every
# *_PROVIDER to a local provider for a deployment where nothing leaves the
# machine — that is a deployment decision made here, once, not something the
# pipeline decides per entry.
#
# Providers currently available: gemini, ollama, fake.

# Fast work on every entry: cleaning, splitting, triage, first-pass reading.
# LUMEN_LIGHTWEIGHT_PROVIDER=gemini
# LUMEN_LIGHTWEIGHT_MODEL=gemini-2.5-flash

# Slow, careful work: reconciliation decisions and escalated readings.
# LUMEN_THINKING_PROVIDER=gemini
# LUMEN_THINKING_MODEL=gemini-2.5-pro

# Turning text into vectors. Changing this model usually means changing
# LUMEN_VECTOR_SIZE and rebuilding the collection.
# LUMEN_EMBEDDING_PROVIDER=gemini
# LUMEN_EMBEDDING_MODEL=text-embedding-004

# Only needed if you are feeding Lumen voice recordings.
# LUMEN_TRANSCRIPTION_PROVIDER=whisper_cpp
# LUMEN_TRANSCRIPTION_MODEL=base.en
# LUMEN_TTS_PROVIDER=macos
# LUMEN_TTS_MODEL=default

# Where a local Ollama daemon is listening, if you point any role at ollama.
# LUMEN_OLLAMA_HOST=http://localhost:11434

# The width of an embedding model Lumen has not been told about. Normally
# unset — setting it is how you say "this is a new model and I know its size"
# instead of being refused.
# LUMEN_EMBEDDING_DIMENSIONS=

# How long to wait, and how hard to try again when a call fails for reasons
# that have nothing to do with the answer.
# LUMEN_LLM_TIMEOUT_SECONDS=60.0
# LUMEN_THINKING_TIMEOUT_SECONDS=180.0
# LUMEN_LLM_MAX_ATTEMPTS=3
# LUMEN_LLM_BACKOFF_BASE=0.5
# LUMEN_LLM_BACKOFF_MAX=8.0

# Rate limits get a much longer ceiling than other failures: cloud quotas are
# counted per minute, so three quick retries all land inside the same
# exhausted minute and fail together.
#
# This applies only where there is nowhere else to go. With several API keys
# configured, a rate-limited call retries under a different key immediately
# and uses LUMEN_LLM_BACKOFF_MAX instead — waiting out a minute would throw
# away the capacity the extra keys were added for.
# LUMEN_LLM_RATE_LIMIT_BACKOFF_MAX=65.0

# How many texts go into one embedding request, and how many requests run at
# once. Concurrency is off by default — firing several at a metered API is the
# quickest way to trip its rate limit.
# LUMEN_EMBED_BATCH_SIZE=32
# LUMEN_EMBED_MAX_WORKERS=1

# Low, because extraction should give the same answer twice.
# LUMEN_LLM_TEMPERATURE=0.2

# Prompts contain journal text. Turning this on writes them to the log file,
# which is useful when debugging a prompt and a privacy problem otherwise.
# LUMEN_LOG_PROMPTS=false


# =============================================================================
# Ingestion
# =============================================================================

# Whether this deployment accepts uploaded chat exports. Set to false for a
# deployment that should be able to read the graph and nothing more; the
# upload routes then disappear from the API entirely.
# LUMEN_ENABLE_INGEST=true


# =============================================================================
# Extraction thresholds
# =============================================================================
# How much attention a piece of writing earns. The right values are only
# discoverable by running real entries through and seeing what gets waved
# through or held back, which is why they are here rather than in the code.

# Below this word count, an entry skips deep analysis.
# LUMEN_MIN_REFLECTION_WORDS=30

# At or above this score, an entry counts as a reflection rather than a note.
# LUMEN_COHERENCE_THRESHOLD=0.4

# Follow-up questions offered when an entry is too thin to analyse.
# LUMEN_REFLECTION_PROMPT_COUNT=3

# Ceilings, not targets. They exist so one runaway model reply cannot turn a
# paragraph into two hundred records; a normal entry never approaches them.
# LUMEN_MAX_EPISODES=12
# LUMEN_MAX_OBSERVATIONS=25
# LUMEN_MAX_CAUSAL_CHAINS=5
# LUMEN_MAX_CAUSAL_STEPS=12

# Tries at reading one episode, counting the first reading plus corrections.
# Setting it to 1 turns correction off entirely.
# LUMEN_MAX_EXTRACTION_ATTEMPTS=3

# A decision reply has nothing to correct — either it arrived readable or it
# did not — so it gets one repeat rather than two.
# LUMEN_MAX_DECISION_ATTEMPTS=2

# How many search matches survive ranking, and how many are fetched before it.
# More are fetched than kept because a rare, weighty record can sit just below
# the cut on raw distance and belong above it once its weight is counted.
# LUMEN_PASS_A_KEEP=5
# LUMEN_PASS_A_OVERFETCH=20
# LUMEN_PASS_B_KEEP=5
# LUMEN_CANDIDATE_CAP=8

# Idle minutes before a live session is treated as finished and processed.
# LUMEN_SESSION_DECAY_MINUTES=120

# Most items allowed to pile up in the human review queue.
# LUMEN_HITL_QUEUE_CAP=40


# =============================================================================
# Reading a live conversation
# =============================================================================
# Everything here trades recall against the rhythm of a conversation. Someone
# talking will forgive an answer that misses a connection; they will not
# forgive a pause before every reply.

# The number that matters most. This call runs on every single turn with a
# person waiting on it, so the deadline is deliberately shorter than any other
# model call in the system — long enough for a fast model, short enough to
# catch a call that has gone wrong.
# LUMEN_FORMULATION_TIMEOUT_SECONDS=0.6

# How much of the conversation the reader sees. Some turns cannot be read
# alone: "I don't feel that anymore" says nothing without the sentence before.
# LUMEN_FORMULATION_CONTEXT_TURNS=4

# LUMEN_MAX_TRIGGERS_PER_TURN=3
# LUMEN_MAX_TRIGGER_KEYWORDS=6
# LUMEN_ERA_VOCABULARY_LIMIT=50
# LUMEN_SESSION_MAX_TURNS=200
# LUMEN_FORMULATION_MAX_WORKERS=4


# =============================================================================
# Logging
# =============================================================================
# One JSON object per line, so logs can be filtered by trace id.

# LUMEN_LOG_LEVEL=INFO
# LUMEN_LOG_FILE=./logs/lumen.jsonl
# LUMEN_LOG_CONSOLE=true


# =============================================================================
# Who may sign in, and who may call from a browser
# =============================================================================

# Whether people have to sign in at all. Off means one person, no identity,
# every request the same user — which is how this runs on a laptop, and what
# the front end's own VITE_AUTH_ENABLED must be set to match.
# LUMEN_AUTH_ENABLED=false

# Sign-in is Google, and Lumen issues its own tokens from it.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback

# Who is allowed in. "allowlist" means only the addresses below; anybody else
# is turned away with a reason rather than a generic failure.
# LUMEN_SIGNUP_MODE=allowlist
# LUMEN_ALLOWED_EMAILS=

# Which addresses a browser may call this service from. The front end is
# served from somewhere else entirely, so without this it cannot reach the
# API at all. Exact origins, comma separated — a wildcard is not merely lax
# here, browsers refuse it outright alongside a session cookie.
# The Vite dev server is the usual first entry:
# LUMEN_ALLOWED_ORIGINS=http://localhost:5173

# Whether the session cookie is only sent over https. Leave it on everywhere
# except a local machine with no certificate.
# LUMEN_COOKIE_SECURE=true
